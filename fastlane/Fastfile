default_platform(:ios)

platform :ios do
  desc "Build the app and run its Swift Testing unit and integration tests"
  lane :unit_tests do |options|
    scan(
      clean: options[:clean] || false,
      only_testing: ["PulseCacheTests"],
      output_directory: "fastlane/test_output/unit_tests",
      result_bundle_path: "fastlane/test_output/unit_tests/PulseCache.xcresult"
    )
  end

  desc "Build the app and run its XCTest UI tests"
  lane :ui_tests do |options|
    scan(
      clean: options[:clean] || false,
      only_testing: ["PulseCacheUITests"],
      output_directory: "fastlane/test_output/ui_tests",
      result_bundle_path: "fastlane/test_output/ui_tests/PulseCache.xcresult"
    )
  end
end
